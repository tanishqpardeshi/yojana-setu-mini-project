# Public container base URL used for OAuth callback URIs
APP_URL=

# Supabase PostgreSQL connection string (leave blank in local preview to use automatic SQLite fallback)
DATABASE_URL=

# Optional HMAC secret used to sign Citizen Email/Password & OTP verification session tokens
CITIZEN_AUTH_SECRET=

# Official MP Samagra Portal (samagra.gov.in) MPSEDC/NIC API integration (optional)
SAMAGRA_API_URL=
SAMAGRA_API_KEY=

# Live Indian (+91) SMS OTP Gateway (e.g., MSG91, Fast2SMS, Twilio proxy)
SMS_API_URL=
SMS_API_KEY=

# Official Government DigiLocker OAuth 2.0 + PKCE Credentials (MeriPehchaan / API Setu)
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_AUTH_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/1/token
DIGILOCKER_ISSUED_DOCS_URL=https://digilocker.meripehchaan.gov.in/public/oauth2/2/files/issued
