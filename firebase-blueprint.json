{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Citizen or admin profile containing Firebase authentication details, Samagra linking, and Indore demographic attributes",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["citizen", "admin"] },
        "authMethod": { "type": "string", "enum": ["google", "email", "samagra"] },
        "samagraId": { "type": "string", "maxLength": 16 },
        "samagraFamilyId": { "type": "string", "maxLength": 16 },
        "samagraMemberId": { "type": "string", "maxLength": 16 },
        "areaType": { "type": "string", "enum": ["urban", "rural"] },
        "wardNumber": { "type": "number" },
        "blockName": { "type": "string", "maxLength": 40 },
        "category": { "type": "string", "enum": ["SC", "ST", "OBC", "GEN", "EWS"] },
        "age": { "type": "number" },
        "gender": { "type": "string", "enum": ["female", "male", "transgender", "any"] },
        "annualIncome": { "type": "number" },
        "occupation": { "type": "string", "maxLength": 60 },
        "isBPL": { "type": "boolean" },
        "hasDisability": { "type": "boolean" },
        "maritalStatus": { "type": "string", "maxLength": 20 },
        "isMpDomicile": { "type": "boolean" },
        "isIndoreResident": { "type": "boolean" },
        "ekycVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "lastLoginAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt"]
    },
    "CitizenApplication": {
      "title": "CitizenApplication",
      "description": "Government scheme application submitted by or for a citizen",
      "type": "object",
      "properties": {
        "arn": { "type": "string", "maxLength": 64 },
        "schemeId": { "type": "string", "maxLength": 64 },
        "schemeName": { "type": "string", "maxLength": 200 },
        "applicantName": { "type": "string", "maxLength": 120 },
        "applicantUid": { "type": "string", "maxLength": 128 },
        "aadhaarLast4": { "type": "string", "maxLength": 4 },
        "samagraId": { "type": "string", "maxLength": 16 },
        "wardNumber": { "type": "number" },
        "status": { "type": "string", "enum": ["Submitted", "Under_Verification", "Field_Inspection", "Approved", "Disbursed", "Rejected"] },
        "appliedAt": { "type": "string", "maxLength": 40 },
        "amountEstimated": { "type": "number" }
      },
      "required": ["arn", "schemeId", "applicantName", "applicantUid", "status", "appliedAt"]
    },
    "SavedScheme": {
      "title": "SavedScheme",
      "description": "Bookmarked government scheme saved to user profile",
      "type": "object",
      "properties": {
        "schemeId": { "type": "string", "maxLength": 64 },
        "schemeTitle": { "type": "string", "maxLength": 200 },
        "savedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["schemeId", "savedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Official district broadcast or alert",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["Normal", "Urgent", "Flash"] },
        "createdAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["title", "message", "priority", "createdAt"]
    },
    "AdminRole": {
      "title": "AdminRole",
      "description": "Server/Console-provisioned District Administrator authorization record",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "role": { "type": "string", "enum": ["admin"] },
        "active": { "type": "boolean" },
        "grantedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["uid", "email", "role", "active"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "AdminRole",
      "description": "Trusted District Administrator role registry (read-only to owner/admin, no client writes)"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User authentication & citizen demographic profile document"
    },
    "/users/{userId}/savedSchemes/{schemeId}": {
      "schema": "SavedScheme",
      "description": "User bookmarked schemes"
    },
    "/applications/{applicationId}": {
      "schema": "CitizenApplication",
      "description": "Government scheme applications"
    },
    "/announcements/{announcementId}": {
      "schema": { "$ref": "Announcement" },
      "description": "District administrative broadcasts"
    }
  }
}
