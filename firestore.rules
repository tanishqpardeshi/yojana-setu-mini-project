rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role in ['citizen', 'operator', 'admin'];
      allow update: if isOwner(userId)
        && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'samagraId', 'wardNumber', 'updatedAt']);
      allow delete: if false;

      match /savedSchemes/{schemeId} {
        allow read, write: if isOwner(userId) && isValidId(schemeId);
      }
    }

    match /applications/{applicationId} {
      allow get: if isSignedIn() && (resource.data.applicantUid == request.auth.uid || request.auth.token.email == 'admin@yojanasetu.gov.in');
      allow list: if isSignedIn() && resource.data.applicantUid == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(applicationId)
        && request.resource.data.applicantUid == request.auth.uid
        && request.resource.data.arn is string
        && request.resource.data.schemeId is string
        && request.resource.data.status in ['Submitted', 'Under_Verification', 'Field_Inspection', 'Approved', 'Disbursed', 'Rejected'];
      allow update: if isSignedIn()
        && isValidId(applicationId)
        && (resource.data.applicantUid == request.auth.uid || request.auth.token.email == 'admin@yojanasetu.gov.in');
      allow delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'admin@yojanasetu.gov.in';
    }

    match /test/{docId} {
      allow read: if true;
    }
  }
}
